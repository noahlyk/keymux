// Default QWERTY steno layout: Plover's built-in "Keyboard" machine mapping, with
// the right hand squished onto the columns its fingers already cover and the four
// vowels moved onto the bottom row.
//
// Plover lists several keys for some steno keys (e.g. S- is both A and Q). The
// first is the steno key's own key; the others are extra keys, written
// "S-|Q" (the part after the | is just a label) and pressed exactly like it.
// Here Q also presses S-, G also presses *, and the whole number row presses #.
//
// Do not edit this file to change your layout. Put differences in your steno
// layer's `layout_overrides` instead:
//
//     layout_overrides: { "S-": Key(KC_Q) },
{
    "S-": Key(KC_A),
    "T-": Key(KC_W),
    "K-": Key(KC_S),
    "P-": Key(KC_E),
    "W-": Key(KC_D),
    "H-": Key(KC_R),
    "R-": Key(KC_F),
    "*": Key(KC_T),
    // Vowels: one key each on the bottom row
    "A-": Key(KC_C),
    "O-": Key(KC_V),
    "-E": Key(KC_N),
    "-U": Key(KC_M),
    // Right hand: index U J, middle I K, ring O L, pinky P ; [ '
    "-F": Key(KC_U),
    "-R": Key(KC_J),
    "-P": Key(KC_I),
    "-B": Key(KC_K),
    "-L": Key(KC_O),
    "-G": Key(KC_L),
    "-T": Key(KC_P),
    "-S": Key(KC_SCLN),
    "-D": Key(KC_LBRC),
    "-Z": Key(KC_QUOT),
    "#": Key(KC_1),
    // Extra keys: Q and A are both S-, T and G are both *, 1 to 0 are all #
    "S-|Q": Key(KC_Q),
    "*|G": Key(KC_G),
    "#|2": Key(KC_2),
    "#|3": Key(KC_3),
    "#|4": Key(KC_4),
    "#|5": Key(KC_5),
    "#|6": Key(KC_6),
    "#|7": Key(KC_7),
    "#|8": Key(KC_8),
    "#|9": Key(KC_9),
    "#|0": Key(KC_0),
}
