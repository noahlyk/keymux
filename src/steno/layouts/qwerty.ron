// Default QWERTY steno layout (first pass, meant to be tuned).
//
// Keys are Plover stroke names. Do not edit this file to change your layout.
// Put differences in your steno layer's `layout_overrides` instead:
//
//     layout_overrides: { "S-": Key(KC_Q) },
{
    "S-": Key(KC_A),
    "T-": Key(KC_S),
    "K-": Key(KC_D),
    "P-": Key(KC_F),
    "W-": Key(KC_Q),
    "H-": Key(KC_W),
    "R-": Key(KC_E),
    "A-": Key(KC_Z),
    "O-": Key(KC_X),
    "*": Key(KC_B),
    "-E": Key(KC_N),
    "-U": Key(KC_M),
    "-F": Key(KC_U),
    "-R": Key(KC_I),
    "-P": Key(KC_O),
    "-B": Key(KC_P),
    "-L": Key(KC_H),
    "-G": Key(KC_J),
    "-T": Key(KC_K),
    "-S": Key(KC_L),
    "-D": Key(KC_SCLN),
    "-Z": Key(KC_SLSH),
    "#": Key(KC_SPC),
}
