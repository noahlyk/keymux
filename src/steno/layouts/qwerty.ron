// Default QWERTY steno layout: Plover's built-in "Keyboard" machine mapping, with
// the right hand squished onto the columns its fingers already cover and the four
// vowels moved onto the bottom row.
//
// Plover lists several keys for some steno keys (e.g. S- is both A and Q). Only
// the first is used here, since each steno key takes one physical key.
//
// Combined keys press two steno keys at once. V is A- and O- together, and B is
// -E and -U together, so the thumb-side vowel pairs take one key instead of two.
//
// Do not edit this file to change your layout. Put differences in your steno
// layer's `layout_overrides` instead:
//
//     layout_overrides: { "S-": Key(KC_Q) },
{
    "S-": Key(KC_A),
    "T-": Key(KC_W),
    "K-": Key(KC_S),
    "P-": Key(KC_E),
    "W-": Key(KC_D),
    "H-": Key(KC_R),
    "R-": Key(KC_F),
    "*": Key(KC_T),
    // Vowels: one key each on the bottom row, with the pairs on V and B
    "A-": Key(KC_X),
    "O-": Key(KC_C),
    "-E": Key(KC_N),
    "-U": Key(KC_M),
    "A-+O-": Key(KC_V),
    "-E+-U": Key(KC_B),
    // Right hand: index Y H U J, middle I K, ring O L, pinky P ;
    "-F": Key(KC_Y),
    "-R": Key(KC_H),
    "-P": Key(KC_U),
    "-B": Key(KC_J),
    "-L": Key(KC_I),
    "-G": Key(KC_K),
    "-T": Key(KC_O),
    "-S": Key(KC_L),
    "-D": Key(KC_P),
    "-Z": Key(KC_SCLN),
    "#": Key(KC_1),
}
