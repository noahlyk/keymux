// Default QWERTY steno layout: Plover's built-in "Keyboard" machine mapping,
// with the right hand squished onto the columns its fingers already cover and
// the vowels moved next to each other on the bottom row.
//
// Plover lists several keys for some steno keys (e.g. S- is both A and Q). Only
// the first is used here, since each steno key takes one physical key.
//
// Do not edit this file to change your layout. Put differences in your steno
// layer's `layout_overrides` instead:
//
//     layout_overrides: { "S-": Key(KC_Q) },
{
    "S-": Key(KC_A),
    "T-": Key(KC_W),
    "K-": Key(KC_S),
    "P-": Key(KC_E),
    "W-": Key(KC_D),
    "H-": Key(KC_R),
    "R-": Key(KC_F),
    "*": Key(KC_T),
    // Vowels: one per finger, next to each other on the bottom row.
    "A-": Key(KC_C),
    "O-": Key(KC_V),
    "-E": Key(KC_N),
    "-U": Key(KC_COMM),
    // Right hand: index Y H U J, middle I K, ring O L, pinky P ;
    "-F": Key(KC_Y),
    "-R": Key(KC_H),
    "-P": Key(KC_U),
    "-B": Key(KC_J),
    "-L": Key(KC_I),
    "-G": Key(KC_K),
    "-T": Key(KC_O),
    "-S": Key(KC_L),
    "-D": Key(KC_P),
    "-Z": Key(KC_SCLN),
    "#": Key(KC_1),
}
