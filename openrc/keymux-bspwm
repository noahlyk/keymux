#!/sbin/openrc-run

name="keymux-bspwm"
description="Keyboard Middleware Bspwm Window Watcher"
# Waits for the keymux daemon, then becomes the watcher. The watcher exits when the daemon
# goes away and supervise-daemon starts it again, which waits for the daemon once more: a
# daemon restart cycles the watcher. `need keymux` below stops it when keymux stops.
command="/usr/bin/keymux"
command_args="wait-daemon -- bspwm-daemon"
supervisor="supervise-daemon"
respawn_delay=3
respawn_max=0
pidfile="/run/${RC_SVCNAME}.pid"
output_log="/var/log/keymux-bspwm.log"
error_log="/var/log/keymux-bspwm.err"

depend() {
    after display-manager
    need keymux
}

start_pre() {
    checkpath --directory --owner root:root --mode 0755 /run
    checkpath --directory --owner root:root --mode 0755 /var/log
}
