[Unit]
Description=Keyboard Middleware Text Box Reader (lets steno see the text it types into)
Documentation=https://github.com/noahlyk/keymux
After=graphical-session.target
Requires=graphical-session.target
# It exits when the compositor has no input method protocol, or another input method (fcitx,
# ibus) has the seat. Don't retry forever.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/bin/keymux textbox
Restart=on-failure
RestartSec=3
Environment="RUST_LOG=info"

[Install]
WantedBy=graphical-session.target
