[Unit]
Description=Keyboard Middleware Steno (on-screen keyboard and tape)
Documentation=https://github.com/noahlyk/keymux
After=graphical-session.target
Requires=graphical-session.target
# It exits when the compositor has no layer-shell (GNOME). Don't retry forever.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/bin/keymux overlay
Restart=on-failure
RestartSec=3
Environment="RUST_LOG=info"

[Install]
WantedBy=graphical-session.target
